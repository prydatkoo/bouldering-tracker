<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Climbs</title>
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&family=IBM+Plex+Mono:wght@400;600&family=VT323&display=swap"
        rel="stylesheet" />
</head>
<h1>Climbs from Database</h1>
<p><a href="/climbs/new" class="button-hero">Add climb</a></p>
<% if (!climbs.length) { %>
    <p> No climbs yet.</p>
    <% } %>

        <ul>
            <% climbs.forEach((c)=> {%>
                <li>
                    <strong>
                        <%= c.name %>
                    </strong> - <%= c.grade %>
                </li>
                <% }) %>
        </ul>

        <body>

        </body>

</html>